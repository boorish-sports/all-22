{
  "manifest_version": 3,
  "name": "All-22 Film Search",
  "version": "3.2.0",
  "description": "Search nflverse play-by-play locally and watch the matching All-22 clip inline on NFL Pro. Requires an NFL Pro subscription.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://pro.nfl.com/*",
    "https://github.com/boorish-sports/all-22-index/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pro.nfl.com/*"
      ],
      "js": [
        "iso.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://pro.nfl.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
